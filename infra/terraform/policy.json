{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Keep only 5 most recent versioned images",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": [ "v" ],
        "countType": "imageCountMoreThan",
        "countNumber": 5
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Protect sahil-admin tagged image",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["sahil-admin", "sahil-agent", "sahil-api", "sahil-client", "sahil-courier", "sahil-maps", "sahil-pay", "sahil-website"],
        "countType": "imageCountMoreThan",
        "countNumber": 1
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}