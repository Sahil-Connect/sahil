ARG NODE_VERSION=18.20.7

FROM node:${NODE_VERSION}-alpine As base

# Add build arguments for database configuration
ARG DATABASE_HOST
ARG DATABASE_USER
ARG DATABASE_PORT
ARG DATABASE_NAME
ARG DATABASE_PASSWORD

# Set environment variables for runtime
ENV DATABASE_HOST=${DATABASE_HOST}
ENV DATABASE_USER=${DATABASE_USER}
ENV DATABASE_PORT=${DATABASE_PORT}
ENV DATABASE_NAME=${DATABASE_NAME}
ENV DATABASE_PASSWORD=${DATABASE_PASSWORD}

FROM base AS builder
RUN apk add --no-cache libc6-compat
RUN apk update
WORKDIR /app
RUN yarn global add turbo
COPY . .
RUN turbo prune api --docker

FROM base AS installer
RUN apk add --no-cache libc6-compat
RUN apk update
WORKDIR /app

# Copy all package.json files first
COPY .gitignore .gitignore
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/yarn.lock ./yarn.lock
RUN yarn install --network-timeout 100000

# Copy source files
COPY --from=builder /app/out/full/ .
COPY turbo.json turbo.json

# Build all required packages in order
RUN yarn workspace @sahil/tsconfig build || true
RUN yarn workspace @sahil/constants build || true
RUN yarn workspace @sahil/lib build
RUN yarn workspace @sahil/features build || true
RUN yarn workspace ui build || true
RUN yarn workspace agent build

# Build and bundle API with dependencies
RUN cd apps/api && yarn install && yarn build

FROM base AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 expressjs
RUN adduser --system --uid 1001 expressjs
USER expressjs
COPY --from=installer /app .

CMD node apps/api/dist/server.js